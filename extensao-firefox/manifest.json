{
  "manifest_version": 3,
  "name": "",
  "version": "1.0.0",
  "description": "Abre a página de nova aba hospedada no GitHub Pages.",
  "chrome_url_overrides": {
    "newtab": "new-tab.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://badlakes.github.io;"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "minha-nova-aba-badlakes@local",
      "strict_min_version": "109.0"
    }
  }
}
